# ecl-dump settings. Copy to ecl310_a266.env (git-ignored) and edit:
#   cp ecl310_a266.env.example ecl310_a266.env
# ecl-dump reads ./ecl310_a266.env, then ./.env, from the folder you run it in.
# Real environment variables override both. --env-file / --host override too.

# Connection: tcp (Modbus TCP, default) or rtu (RS-485 serial)
ECL310_MODBUS_MODE=tcp

# Modbus TCP. ECL310_HOST is required in tcp mode (192.168.1.100 is a placeholder).
ECL310_HOST=192.168.1.100
ECL310_PORT=502

# Modbus unit id: the controller's Modbus addr. (ID 38, Common controller settings > System > Communication).
# Factory setting 1.
ECL310_UNIT_ID=1

# Modbus RTU (only used when ECL310_MODBUS_MODE=rtu)
# ECL310_SERIAL_PORT=/dev/tty.usbserial-0001
# ECL310_BAUDRATE=38400
# ECL310_PARITY=N
# ECL310_STOPBITS=1
# ECL310_BYTESIZE=8

# A266 subtype: 1, 2, 9 or 10
ECL310_APP=1

# Language: da or en. Default: LANG / LC_MESSAGES, else English.
ECL310_LANG=en

# CSV output directory. Default: platform user data dir
#   macOS:   ~/Library/Application Support/danfoss-ecl/dumps
#   Linux:   ~/.local/share/danfoss-ecl/dumps
#   Windows: %APPDATA%\danfoss-ecl\danfoss-ecl\dumps
# ECL310_OUTPUT_DIR=/path/to/dumps
