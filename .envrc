# direnv: run `direnv allow` once (and again after editing this file).
# Entering the repo folder then puts the .venv on PATH and loads your settings.

# Use the project virtualenv (create it with: python3 -m venv .venv && .venv/bin/pip install -e ".[dev]")
if [[ -d .venv ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add .venv/bin
fi

# Your private settings (git-ignored). Copy ecl310_a266.env.example to create it.
watch_file ecl310_a266.env
dotenv_if_exists ecl310_a266.env

# Optional personal additions that should not be committed.
source_env_if_exists .envrc.local
