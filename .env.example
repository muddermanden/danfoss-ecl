ECL310_MODBUS_MODE=tcp
ECL310_HOST=192.168.1.100
ECL310_PORT=502
ECL310_UNIT_ID=1
# A266 subtype: 1, 2, 9 or 10
ECL310_APP=1

# Language: da or en (default: ECL310_LANG, else LANG / LC_MESSAGES)
ECL310_LANG=da

# CSV output directory. Default: platform user data dir
#   macOS:  ~/Library/Application Support/danfoss-ecl/dumps
#   Linux:  ~/.local/share/danfoss-ecl/dumps
# ECL310_OUTPUT_DIR=/path/to/dumps
